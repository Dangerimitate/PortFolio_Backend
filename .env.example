# Server & Security
PORT=3000
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key
JWT_REFRESH_EXPIRES_IN=7d
MONGODB_URI=mongodb://127.0.0.1:27017/sso

# Email Dispatch via SMTP (Gmail App Password / Outlook / SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
EMAIL_FROM="SkarProvince Identity" <your_email@gmail.com>

# Cellular SMS Dispatch (Optional: Twilio or Fast2SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
FAST2SMS_API_KEY=
